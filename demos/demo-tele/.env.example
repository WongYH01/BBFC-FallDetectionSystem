# Copy this to .env and fill in your value. Never commit .env.
#
# Get a token from @BotFather in Telegram: /newbot, follow the prompts, and it
# hands you a string shaped like 8123456789:AAH... That string is a full
# credential for the bot — treat it like a password (design doc §9.2).
TELEGRAM_BOT_TOKEN=

# Port for the bench UI. 5001 by default so it does not collide with demo-cam's
# Flask app on 5000.
#PORT=5001
