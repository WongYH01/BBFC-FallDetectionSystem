# Copy this to .env and fill in your values
# Never commit .env to git

# Flask secret key - generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-real-secret

# Login credentials for the Flask web app
APP_USERNAME=admin
APP_PASSWORD=change-me-strong-password

# MediaMTX stream credentials (must match mediamtx.yml authInternalUsers)
STREAM_USERNAME=fallcam
STREAM_PASSWORD=change-me-stream-password

# MediaMTX host - use Tailscale IP or hostname
# On the Pi itself this can be 127.0.0.1
MEDIAMTX_HOST=100.x.x.x
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_RTSP_PORT=8554

# Stream path name (must match mediamtx.yml paths key)
STREAM_PATH=cam

# --- v1 fall heuristic (optional; defaults shown) ---------------------------
# A person is "fallen" when their bounding box width/height exceeds FALL_RATIO.
# 1.0 means literally "wider than tall". The right value depends entirely on
# camera height and angle — set FALL_DEBUG=1 to draw each box's live ratio on
# the feed, watch someone stand and lie down, and pick a value between the two.
#FALL_RATIO=1.0
#FALL_MIN_FRAMES=3     # consecutive wide frames before the alert latches
#FALL_CLEAR_FRAMES=5   # consecutive upright frames before it clears
#FALL_DEBUG=0          # 1 = draw the w/h ratio next to every box

# Every recording also writes a skeleton-only companion file next to it
# (pose_<ts>_skeleton.mp4): the same pose drawn on a blank canvas, no camera
# image. This sets that canvas — "black" reads best on screen, "white" for
# slides and print.
#SKELETON_BG=black

# --- v1 measurement mode (optional; defaults shown) -------------------------
# Tick "Collect metrics" in the sidebar before pressing Record. Writes
# metrics/metrics_<ts>.json + _frames.csv and NO video. See v1/METRICS.md for
# what each figure does and does not measure.
#METRICS_WARMUP_FRAMES=30   # frames dropped from the summary (CUDA/cuDNN warm-up)
#KPT_CONF_THRESH=0.25       # confidence above which a keypoint counts as visible

# --- v2 fall detection (optional; defaults shown) ---------------------------
# v2 replaces the box rule with the calibrated transformer model: the largest
# person's keypoints fill a 4 s ring buffer, one window is scored per second by
# `augnone_ms_coords_hn_s99.pt`, a logistic head fitted on this room's own clips
# (`probe_augnone_ms_coords_hn_s99.npz`) reads that score, and the rolling mean
# over the last BUFFER_LEN windows latches the alarm. Held out on the camera's
# five subjects: window AUC 0.992, rolling F1 0.967 (1 false alarm, 1 miss),
# against 0.836 for the best single checkpoint and 0.853 for the old four-model
# ensemble. Set CALIBRATION_HEAD= (empty) to run the checkpoint's own
# classifier, or set ENSEMBLE_CKPTS to several files to run the four-model mean
# again. The v1 box rule still draws (FALL_DEBUG=1) but no longer decides. See
# v2/README.md for measured behaviour and caveats.

# Hugging Face read token for scripts/fetch_weights.py. The weights repo is
# private, and this file is the ONLY place the fetch script looks for the token.
# Create one at https://huggingface.co/settings/tokens with "Read" scope.
# Read scope is all fetching needs. It cannot update the release: a fine-grained
# read token is refused with 403 on the upload endpoint, so publishing new
# weights means a write credential -- `hf auth login` as the repo owner, or a
# token with write scope (create one and use it directly, not via this var).
#FALL_WEIGHTS_TOKEN=hf_xxx

#POSE_SCALE=yolo26n         # backbone size n/s/m; used to pick {scale}-pose.onnx
                           # yolo26n is the scale the head was fitted on at 640
#POSE_MODEL=..\models\yolo26n-pose.onnx   # explicit file, overrides POSE_SCALE
#POSE_IMGSZ=640
#POSE_THREADS=2             # ONNX Runtime pool for the pose graph; 0 = ORT default
                           # (all cores, spinning). Measured at 640: default
                           # 8.4 ms wall / 70 ms CPU per frame, 2 threads
                           # 16.4 / 33 -- the wall work is the same, the CPU
                           # halves because the default pool busy-waits.
#STREAM_FRAME_STRIDE=1      # rows between window samples; 1 pairs with VID_STRIDE=2
#CALIBRATION_HEAD=C:/path/runs/checkpoints/probe_augnone_ms_coords_hn_s99.npz
                           # empty = use the checkpoint's own classifier
#ENSEMBLE_CKPTS=C:/path/runs/checkpoints/augnone_ms_coords_hn_s99.pt
                           # one file = the calibrated model; several = their mean
#BUFFER_LEN=4               # windows in the rolling mean (4 windows ~ 4 s)
#FALL_THRESHOLD=0.5         # rolling mean that engages the alarm
#FALL_MIN_DESCENT=0.10      # body lengths/s of hip descent a window needs
                           # before it may raise the alarm; 0 disables the gate
#FALL_CLEAR_BELOW=0.2       # rolling mean below which clearing starts
#FALL_CLEAR_WINDOWS=2       # consecutive updates below it before the alarm clears
#FALL_CLIPS_ENABLED=1       # 0 disables the automatic pre-buffered clip capture

# --- shared stream reader (v2/detector.py) ---------------------------------
# These exist because of one failure mode, worth naming so the settings make
# sense. MediaMTX on the Pi logs
#
#   [RTSP] [session ...] reader is too slow, discarding 469 frames
#
# when a client does not pull frames off its socket fast enough. MediaMTX never
# blocks the camera to wait for us: each reader has a fixed queue, and when it
# fills the oldest frames are thrown away. 469 frames in three seconds is not
# "a bit behind", it is a reader that stopped reading entirely.
#
# The structural fix is in the code -- /video_feed used to open a fresh RTSP
# connection and a fresh inference loop per browser tab, and now every viewer
# shares one of each. The knobs below are the tuning that is left. Watch
# /stream/status while you change them.

# Decode-and-score one frame in every N. The socket is still drained at full
# rate, so this lowers CPU without making us a slow reader. What matters is the
# ROW rate the window sees: training rows are 2 frames apart at 30 fps ≈ 67 ms.
#
#   camera 30 fps -> VID_STRIDE=2 + STREAM_FRAME_STRIDE=1   (half the pose cost)
#   camera 30 fps -> VID_STRIDE=1 + STREAM_FRAME_STRIDE=2   (the old default)
#   camera 15 fps -> VID_STRIDE=1 + STREAM_FRAME_STRIDE=1   (the Pi's config)
#
# Getting it wrong changes the window's time span, not just its cost: at 15 fps
# with VID_STRIDE=2 a 60-row window covers ~8 s instead of 4. Measured on the
# 9800X3D: posing every 2nd frame reproduces the full-rate rows bit-for-bit.
#VID_STRIDE=1

# Quality of the MJPEG frames sent to the browser (OpenCV's own default is 95).
#JPEG_QUALITY=75

# Seconds without a decoded frame before the reader force-reconnects. This is
# the guard against the Pi's hardware encoder dying mid-stream -- the ioctl
# (VIDIOC_QBUF) failures in its journal -- which from here looks like a healthy
# TCP connection that has simply gone silent forever.
#STREAM_STALL_SEC=8

# Seconds after the last browser closes before the RTSP connection is dropped.
# Ignored while FALL_CLIPS_ENABLED=1 or a recording is running: detection is
# the point, a browser being open is not.
#IDLE_STOP_SEC=30

# Device for the pose model. Empty means "pick from the model" -- ONNX exports
# run on ONNX Runtime, and asking Ultralytics for CUDA while the session is on
# CPU dies on the first frame with "no data transfer registered for copying
# tensors from Device:[DeviceType:1] to Device:[DeviceType:0]". Set it to cuda
# only with an onnxruntime-gpu build.
#POSE_DEVICE=

# Set to 1 for the Flask debugger. The auto-reloader stays off either way -- it
# loads the model twice and can leave two RTSP readers on the Pi at once.
#FLASK_DEBUG=0

