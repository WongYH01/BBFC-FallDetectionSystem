# Copy to .env and fill in. Never commit .env.
# Only what a deployment must set; every other setting has a working default
# (service/config.py, v2/README.md "Settings").

# Room this instance watches
ROOM_ID=picam
ROOM_NAME=Pi Camera

# Notification service (compose hostname; host run: http://localhost:8081/...)
NOTIFICATION_BASE_URL=http://notification:8081/api/v1/notification

# Camera stream (MediaMTX)
MEDIAMTX_HOST=100.x.x.x
STREAM_USERNAME=fallcam
STREAM_PASSWORD=change-me-stream-password

# Hugging Face read token for scripts/fetch_weights.py and the image build
FALL_WEIGHTS_TOKEN=hf_xxx

# No raw camera footage leaves the host (ADR 0001)
ALLOW_MANUAL_RECORDING=0

# 15 fps camera: pose every frame, window every row. 30 fps: VID_STRIDE=2
VID_STRIDE=1
STREAM_FRAME_STRIDE=1

# Alarm on in ~1.3 s, off in ~1.9 s (defaults 4 / 2 are ~1 s slower each way)
BUFFER_LEN=2
FALL_CLEAR_WINDOWS=1

# Collapse an alarm that drops and returns within 60 s into one alert
EVENT_COOLDOWN_SEC=60
