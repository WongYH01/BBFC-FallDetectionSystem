# Copy to services/detection/.env and fill in. Never commit .env.
#
# The detection service reuses demo-cam/v2's settings; the stream, pose and
# fall-decision variables are documented in ../../demo-cam/.env.example and
# are read from the environment exactly as there. Only the service-specific
# ones are listed here.

# --- identity (required) -----------------------------------------------------
# One service instance watches one room/camera. These go into every alert.
ROOM_ID=picam
ROOM_NAME=Pi Camera

# --- notification service ----------------------------------------------------
# The Spring service's context path is /api/v1/notification. Inside the
# compose network the hostname is the service name from the notification
# compose file; from a host-run service use http://localhost:8081/...
NOTIFICATION_BASE_URL=http://notification:8081/api/v1/notification

# Per-request timeout, and the ceiling for the exponential retry backoff.
# Retries continue indefinitely: a fall alert is not dropped for being
# temporarily unreachable.
#NOTIFY_TIMEOUT_SEC=15
#NOTIFY_MAX_BACKOFF_SEC=60

# --- stream / camera (from demo-cam/.env.example) ----------------------------
MEDIAMTX_HOST=100.x.x.x
MEDIAMTX_RTSP_PORT=8554
STREAM_USERNAME=fallcam
STREAM_PASSWORD=change-me-stream-password
STREAM_PATH=cam

# --- detection ---------------------------------------------------------------
# Raw camera footage must never be stored by the service: this disables the
# manual Record button (v2/videos/pose_<ts>.mp4 is a side-by-side with the
# camera image). The automatic fall clip is skeleton-only either way, and the
# 403 on /record/start is the guard that keeps it that way.
ALLOW_MANUAL_RECORDING=0

# Required by the service: the skeleton clip is the alert payload and it is
# also what keeps the RTSP reader alive with no browser attached.
FALL_CLIPS_ENABLED=1

# The calibrated pairing the head was fitted on; do not change without
# refitting (see demo-cam/v2/README.md).
#POSE_SCALE=yolo26n
#POSE_IMGSZ=640
#POSE_THREADS=2
#CALIBRATION_HEAD=   # empty = the checkpoint's own classifier
#ENSEMBLE_CKPTS=     # defaults to runs/checkpoints/augnone_ms_coords_hn_s99.pt
#BUFFER_LEN=4
#FALL_THRESHOLD=0.5
#FALL_MIN_DESCENT=0.10

# --- outbox ------------------------------------------------------------------
# Durable spool for notifications that have not been accepted yet. In compose
# this is a named volume; a host run defaults to services/detection/spool/.
#SPOOL_DIR=/data/outbox

# Delete the local skeleton clip once the notification service has it.
#KEEP_UPLOADED_CLIPS=0

# Optional extra suppression between alerts. The recorder will not start a
# second clip until the alarm has CLEARED (so a latch that simply holds -- a
# person still on the floor -- raises one alert, not one every 20 s), but an
# alarm that drops and comes back within seconds still counts as a new incident
# there. This collapses those into the first alert; the later clip is dropped
# rather than queued. 0 = off, 60 is a sane room default.
#EVENT_COOLDOWN_SEC=60

# Refuse to upload a clip larger than this (the notification service's own
# limit is 8 MiB; clips this size are far smaller).
#MAX_CLIP_BYTES=8388608

# Re-attach clips that finished while the service was restarting.
#RECONCILE_CLIPS=1

# --- service plumbing --------------------------------------------------------
# The capture thread starts at boot; set 0 to only detect while a browser has
# the UI open (not what a deployment wants).
#DETECTOR_AUTOSTART=1
#SERVICE_UI_HOST=127.0.0.1
#SERVICE_UI_PORT=5005
